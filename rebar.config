{erl_opts, [debug_info, warnings_as_errors]}.

%% erlang_wasm needs the fixes on its `beam-guest` branch. Until they are
%% merged, link a checkout of that branch as _checkouts/wasm (see README.md).
{deps, [
    {wasm, {git, "https://github.com/benoitc/erlang_wasm.git", {branch, "main"}}}
]}.

{shell, [{apps, [beam_on_beam]}]}.
